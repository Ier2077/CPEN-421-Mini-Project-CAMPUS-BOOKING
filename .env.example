# .env.example — copy to .env and fill in your values

# ── Database (Option A: individual fields for local dev) ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campus_booking
DB_USER=postgres
DB_PASSWORD=yourpassword

# ── Database (Option B: Render / Neon cloud connection string)
# DATABASE_URL=postgres://user:password@host:5432/campus_booking

# ── Server
PORT=3000
NODE_ENV=development

# ── Session secret (CHANGE THIS — use a long random string!)
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-secret-string
